 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "当前，我国正处于实现中华民族伟大复兴的关键时期，改革发展稳定任务艰巨繁重，对基层治理提出了更高要求。",
  "source": "人民日报"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "基层治理是国家治理的基石。完善基层治理体系，提升基层治理能力，是推进国家治理体系和治理能力现代化的重要内容。",
  "source": "求是网"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "营商环境是企业生存发展的土壤。优化营商环境，就是解放生产力、提升竞争力。",
  "source": "新华网"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "乡村振兴战略是新时代\"三农\"工作的总抓手。推进乡村全面振兴，必须坚持农业农村优先发展。",
  "source": "人民日报"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "绿色发展是高质量发展的底色。坚持绿水青山就是金山银山理念，推动经济社会发展全面绿色转型。",
  "source": "求是网"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "数字经济是把握新一轮科技革命和产业变革新机遇的战略选择，正在成为重组全球要素资源、重塑全球经济结构的关键力量。",
  "source": "新华网"
 },
 {
  "topic": "开头",
  "use": "好词好句",
  "text": "民生无小事，枝叶总关情。保障和改善民生没有终点，只有连续不断的新起点。",
  "source": "人民日报"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "然而，我们也要清醒认识到，基层治理中仍然存在不少问题和短板。",
  "source": "人民日报"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "一方面，...；另一方面，...。二者相互交织，增添了问题的复杂性。",
  "source": "求是网"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "造成上述问题的原因是多方面的，既有体制机制不健全的客观因素，也有思想认识不到位的主观原因。",
  "source": "人民日报"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "综上所述，解决这些问题需要多方协同、久久为功，既要有紧迫感，也要有耐心。",
  "source": "新华网"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "对此，我们必须坚持问题导向，找准突破口，以点带面推动整体提升。",
  "source": "人民日报"
 },
 {
  "topic": "过渡",
  "use": "好词好句",
  "text": "从更深层次看，这些问题折射出的是发展理念、治理方式、工作方法等方面的深层矛盾。",
  "source": "求是网"
 },
 {
  "topic": "论证",
  "use": "好词好句",
  "text": "实践证明，坚持党建引领是提升基层治理效能的根本保证。",
  "source": "人民日报"
 },
 {
  "topic": "论证",
  "use": "好词好句",
  "text": "从调研情况看，各地在推进基层治理现代化方面已经取得了阶段性成效，但距离人民群众的期盼还有差距。",
  "source": "求是网"
 },
 {
  "topic": "论证",
  "use": "好词好句",
  "text": "以浙江省为例，该地通过\"最多跑一次\"改革，实现了政务服务效率的大幅提升，其经验值得各地借鉴。",
  "source": "新华网"
 },
 {
  "topic": "论证",
  "use": "好词好句",
  "text": "数据显示，全国已建成城乡社区综合服务设施50余万个，覆盖率达到90%以上，充分说明了基层服务体系建设的成效。",
  "source": "人民日报"
 },
 {
  "topic": "论证",
  "use": "好词好句",
  "text": "正如习近平总书记指出：\"社区是基层基础，只有基础坚固，国家大厦才能稳固。\"这深刻揭示了基层治理的重要地位。",
  "source": "人民日报"
 },
 {
  "topic": "对策",
  "use": "好词好句",
  "text": "一是加强顶层设计，完善基层治理制度体系，确保各项工作有章可循、有据可依。",
  "source": "求是网"
 },
 {
  "topic": "对策",
  "use": "好词好句",
  "text": "二是强化要素保障，加大对基层治理的人力、物力、财力投入力度。",
  "source": "人民日报"
 },
 {
  "topic": "对策",
  "use": "好词好句",
  "text": "三是创新工作方式，推动基层治理数字化转型，让数据多跑路、群众少跑腿。",
  "source": "新华网"
 },
 {
  "topic": "对策",
  "use": "好词好句",
  "text": "四是注重人才培养，打造一支懂治理、能治理、善治理的基层干部队伍。",
  "source": "人民日报"
 },
 {
  "topic": "对策",
  "use": "好词好句",
  "text": "五是加强监督考核，建立健全基层治理评价体系，确保各项政策落地见效。",
